// ExecuteIndirect with a vertex or index buffer argument: copies the records the application wrote to a scratch buffer
// and adds the GPU address arena's device address (heap_base) to each buffer view's console virtual address, so
// VK_EXT_device_generated_commands reads the views as device addresses (vulkan_indirect.h). One invocation per dword, in a 2D grid numbered row by row.
#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 64) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint w[]; };
layout(push_constant) uniform Patch {
    uint64_t source;
    uint64_t destination;
    uint64_t heap_base;
    uint dwords;         // records x stride in dwords
    uint stride_dwords;
    uint patch_count;
    uint offsets[17];    // dword offsets in a record of the 64-bit addresses to rebase
} p;
void main() {
    uint i = gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * 64u) + gl_GlobalInvocationID.x;  // 2D grid, row by row
    if (i >= p.dwords) return;
    Words src = Words(p.source);
    Words dst = Words(p.destination);
    uint v = src.w[i];
    uint at = i % p.stride_dwords;
    for (uint k = 0; k < p.patch_count; ++k) {
        if (p.offsets[k] == at) {
            uint64_t address = packUint2x32(uvec2(v, src.w[i + 1]));
            if (address != 0ul) v = unpackUint2x32(address + p.heap_base).x;
        } else if (p.offsets[k] + 1 == at) {
            uint64_t address = packUint2x32(uvec2(src.w[i - 1], v));
            if (address != 0ul) v = unpackUint2x32(address + p.heap_base).y;
        }
    }
    dst.w[i] = v;
}
